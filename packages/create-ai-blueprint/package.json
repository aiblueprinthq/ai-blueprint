{
  "name": "create-ai-blueprint",
  "version": "0.6.0",
  "description": "Install a file-backed, spec-driven AI development workflow into a scaffolded app.",
  "license": "MIT",
  "author": "Brad Traversy",
  "type": "module",
  "homepage": "https://ai-blueprint.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradtraversy/ai-blueprint.git",
    "directory": "packages/create-ai-blueprint"
  },
  "bugs": {
    "url": "https://github.com/bradtraversy/ai-blueprint/issues"
  },
  "keywords": [
    "ai",
    "ai-coding",
    "blueprint",
    "codex",
    "claude",
    "claude-code",
    "agent",
    "context-engineering",
    "spec-driven-development",
    "workflow",
    "scaffold"
  ],
  "bin": {
    "create-ai-blueprint": "dist/bin/create-ai-blueprint.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/update.test.ts",
    "check:pack": "npm pack --dry-run",
    "prepare-template": "tsx scripts/prepare-template.ts",
    "prepack": "npm run build && npm run prepare-template",
    "postpack": "tsx scripts/clean-template.ts"
  },
  "files": [
    "dist/",
    "template/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
