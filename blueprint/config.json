{
  "schemaVersion": 1,
  "workflow": {
    "stepReview": "feature",
    "checkpointCommits": "disabled"
  },
  "git": {
    "landing": "local-merge",
    "featureBranchPrefix": "feature/",
    "fixBranchPrefix": "fix/"
  },
  "verification": {
    "logicTests": "when-configured",
    "uiEvidence": "when-available"
  },
  "review": {
    "independentExecution": "automatic"
  },
  "qualityGates": {
    "regular": {
      "audit": "manual",
      "independentReview": "when-sensitive",
      "check": "manual",
      "tryGuide": "when-testable",
      "specCheck": "manual"
    },
    "continuous": {
      "audit": "manual",
      "independentReview": "when-sensitive",
      "check": "manual",
      "tryGuide": "when-testable",
      "specCheck": "manual"
    }
  },
  "continuous": {
    "maxFeatures": null,
    "maxRepairAttempts": 2,
    "finalIntegrationAudit": false
  }
}
