{
  "name": "ai-blueprint-maintainer",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Maintainer validation commands for AI Blueprint.",
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && tsx scripts/check-blueprint.ts",
    "check:static": "tsx scripts/validate-blueprint.ts",
    "test": "npm --prefix packages/create-ai-blueprint test",
    "test:routing": "tsx --test scripts/evals/routing.test.ts && tsx scripts/evals/routing.ts --min-rank1 90",
    "test:package": "tsx scripts/smoke-package.ts",
    "test:e2e": "tsx scripts/e2e/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.2"
  }
}
